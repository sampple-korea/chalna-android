<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Chalna" parent="android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSplashScreenBackground">#07080D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_chalna_mark</item>
        <item name="android:windowSplashScreenAnimationDuration">180</item>
    </style>
</resources>

